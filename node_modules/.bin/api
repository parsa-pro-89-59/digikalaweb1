#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -x "$basedir/node" ]; then
  exec NODE_OPTIONS=--no-warnings "$basedir/node"  "$basedir/../api/bin/api.js" "$@"
else 
  exec NODE_OPTIONS=--no-warnings node  "$basedir/../api/bin/api.js" "$@"
fi
